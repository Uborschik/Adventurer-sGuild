# Автоопределение текстовых файлов
* text=auto eol=lf

# Windows-специфичные — CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Бинарные — не трогать
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.wav binary
*.ogg binary
*.mp3 binary
*.aseprite binary
*.uid binary

# Godot-специфичные — LF
*.tres text eol=lf
*.tscn text eol=lf
*.godot text eol=lf
*.import text eol=lf