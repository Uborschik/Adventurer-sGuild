{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Запуск Godot (C#)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "F:/Godot_C#/Core/Godot_v4.7.2-stable_mono_win64.exe",
            "args": ["--path", "${workspaceFolder}"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false
        },
        {
            "name": "Запуск Editor",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/AdventurersGuild.Editor"
            ],
            "cwd": "${workspaceFolder}/AdventurersGuild.Editor",
            "console": "internalConsole",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            }
        }
    ]
}