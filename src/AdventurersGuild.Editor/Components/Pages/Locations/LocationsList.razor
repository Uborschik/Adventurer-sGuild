@page "/locations"
@inject LocationRepository Repo
@inject NavigationManager Nav

<PageTitle>Локации</PageTitle>

<MudText Typo="Typo.h4">Локации</MudText>

<div class="d-flex justify-end mt-4 mb-2">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="CreateNew">
        Новая локация
    </MudButton>
</div>

<MudTable Items="@Repo.All" Dense="true" Hover="true" Bordered="true">
    <HeaderContent>
        <MudTh>Id</MudTh>
        <MudTh>Имя (ru)</MudTh>
        <MudTh>Имя (en)</MudTh>
        <MudTh Style="width:120px">Сложность</MudTh>
        <MudTh Style="width:120px">Дорога, дн.</MudTh>
        <MudTh Style="width:200px"></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Id</MudTd>
        <MudTd>@context.Name?.Ru?.Nom</MudTd>
        <MudTd>@context.Name?.En</MudTd>
        <MudTd>@context.DifficultyModifier.ToString("+0.0;-0.0;0.0")</MudTd>
        <MudTd>@context.TravelDaysModifier</MudTd>
        <MudTd>
            <MudButton Size="Size.Small" OnClick="@(() => Edit(context.Id))">Редактировать</MudButton>
            <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => ConfirmDelete(context))">Удалить</MudButton>
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    [Inject] public IDialogService DialogService { get; set; } = default!;

    private void CreateNew()
    {
        Nav.NavigateTo("/locations/__new__");
    }

    private void Edit(string id)
    {
        Nav.NavigateTo($"/locations/{id}");
    }

    private async Task ConfirmDelete(LocationInfo item)
    {
        bool? ok = await DialogService.ShowMessageBox(
            "Удалить локацию",
            $"Удалить '{item.Id}'?",
            yesText: "Удалить", cancelText: "Отмена");

        if (ok == true)
        {
            Repo.Delete(item.Id);
            StateHasChanged();
        }
    }
}