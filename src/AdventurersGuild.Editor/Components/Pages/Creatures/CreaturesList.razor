@page "/creatures"
@inject CreatureRepository Repo
@inject NavigationManager Nav
@inject IDialogService DialogService

<PageTitle>Существа</PageTitle>

<MudText Typo="Typo.h4">Существа</MudText>

<div class="d-flex justify-end mt-4 mb-2">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="CreateNew">
        Новое существо
    </MudButton>
</div>

<MudTable Items="@Repo.All" Dense="true" Hover="true" Bordered="true">
    <HeaderContent>
        <MudTh>Id</MudTh>
        <MudTh>Имя (ru)</MudTh>
        <MudTh>Имя (en)</MudTh>
        <MudTh Style="width:110px">Ур.</MudTh>
        <MudTh Style="width:110px">Contrib.</MudTh>
        <MudTh Style="width:200px"></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Id</MudTd>
        <MudTd>@context.Name?.Ru?.Nom</MudTd>
        <MudTd>@context.Name?.En</MudTd>
        <MudTd>@context.MinLvl–@context.MaxLvl</MudTd>
        <MudTd>@(context.Contributions?.Count ?? 0)</MudTd>
        <MudTd>
            <MudButton Size="Size.Small" OnClick="@(() => Edit(context.Id))">Редактировать</MudButton>
            <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => ConfirmDelete(context))">Удалить</MudButton>
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private void CreateNew() => Nav.NavigateTo("/creatures/__new__");

    private void Edit(string id) => Nav.NavigateTo($"/creatures/{id}");

    private async Task ConfirmDelete(CreatureInfo item)
    {
        bool? ok = await DialogService.ShowMessageBox(
            "Удалить существо",
            $"Удалить '{item.Id}'? Это может нарушить ссылки в Bestiary.",
            yesText: "Удалить", cancelText: "Отмена");

        if (ok == true)
        {
            Repo.Delete(item.Id);
            StateHasChanged();
        }
    }
}