@page "/compendium/{Kind}"
@using AdventurersGuild.Editor.Compendium
@inject CompendiumService Compendium
@inject NavigationManager Nav
@inject IDialogService DialogService

@if (Info is null)
{
    <MudAlert Severity="Severity.Error">Kind «@Kind» не зарегистрирован.</MudAlert>
    return;
}

<PageTitle>@Info.PluralTitle</PageTitle>

<div class="page-host scroll">
    <div class="page-header">
        <div class="page-title">@Info.PluralTitle</div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="CreateNew">
            Новый
        </MudButton>
    </div>

    @if (!Entries.Any())
    {
        <div class="entity-empty">Пусто. Нажмите «Новый», чтобы создать первую запись.</div>
    }
    else
    {
        <div class="entity-list">
            @foreach (var e in Entries)
            {
                <div class="entity-row" @onclick="@(() => Edit(e.Id))">
                    <span class="entity-id">@e.Id</span>
                    <span class="entity-name">@e.DisplayName</span>
                    <span class="entity-delete" @onclick:stopPropagation="true">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => ConfirmDelete(e))" />
                    </span>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Kind { get; set; } = "";

    private KindInfo? Info => Kinds.Get(Kind);

    private IReadOnlyList<CompendiumEntry> Entries =>
        Compendium.Index.AllOfKind(Kind).OrderBy(e => e.Id).ToList();

    private void CreateNew() => Nav.NavigateTo($"/compendium/{Kind}/__new__");
    private void Edit(string id) => Nav.NavigateTo($"/compendium/{Kind}/{id}");

    private async Task ConfirmDelete(CompendiumEntry entry)
    {
        bool? ok = await DialogService.ShowMessageBox(
            "Удалить",
            $"Удалить «{entry.DisplayName}» ({entry.Id})?",
            yesText: "Удалить", cancelText: "Отмена");

        if (ok == true)
        {
            Compendium.Delete(entry);
            StateHasChanged();
        }
    }
}