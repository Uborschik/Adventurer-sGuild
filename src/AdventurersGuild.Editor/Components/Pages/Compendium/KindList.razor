@page "/compendium/{Kind}"
@using AdventurersGuild.Editor.Compendium
@inject CompendiumService Compendium
@inject NavigationManager Nav
@inject IDialogService DialogService

@if (Info is null)
{
    <MudAlert Severity="Severity.Error">Kind «@Kind» не зарегистрирован.</MudAlert>
    return;
}

<PageTitle>@Info.PluralTitle</PageTitle>

<MudText Typo="Typo.h4">@Info.PluralTitle</MudText>

<div class="d-flex justify-end mt-4 mb-2">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="CreateNew">
        Новый
    </MudButton>
</div>

<MudTable Items="@Entries" Dense="true" Hover="true" Bordered="true">
    <HeaderContent>
        <MudTh>@Info.IdField</MudTh>
        <MudTh>Название</MudTh>
        <MudTh Style="width:220px"></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Id</MudTd>
        <MudTd>@context.DisplayName</MudTd>
        <MudTd>
            <MudButton Size="Size.Small" OnClick="@(() => Edit(context.Id))">Редактировать</MudButton>
            <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => ConfirmDelete(context))">Удалить</MudButton>
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    [Parameter] public string Kind { get; set; } = "";

    private KindInfo? Info => Kinds.Get(Kind);

    private IReadOnlyList<CompendiumEntry> Entries =>
        Compendium.Index.AllOfKind(Kind).OrderBy(e => e.Id).ToList();

    private void CreateNew() => Nav.NavigateTo($"/compendium/{Kind}/__new__");
    private void Edit(string id) => Nav.NavigateTo($"/compendium/{Kind}/{id}");

    private async Task ConfirmDelete(CompendiumEntry entry)
    {
        bool? ok = await DialogService.ShowMessageBox(
            "Удалить",
            $"Удалить «{entry.DisplayName}» ({entry.Id})?",
            yesText: "Удалить", cancelText: "Отмена");

        if (ok == true)
        {
            Compendium.Delete(entry);
            StateHasChanged();
        }
    }
}