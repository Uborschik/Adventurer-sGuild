@page "/"
@inject CompendiumService Compendium
@inject NavigationManager Nav

<PageTitle>Compendium</PageTitle>

<MudText Typo="Typo.h3">Compendium</MudText>

<MudGrid Class="mt-4">
    @foreach (var kind in Kinds.All)
    {
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudPaper Class="pa-4" Outlined="true" Elevation="0"
                      Style="cursor:pointer;"
                      @onclick="@(() => Nav.NavigateTo($"/compendium/{kind.Kind}"))">
                <MudText Typo="Typo.caption">@kind.SingularTitle</MudText>
                <MudText Typo="Typo.h5">@Compendium.Index.CountOf(kind.Kind)</MudText>
                <MudText Typo="Typo.caption">@kind.PluralTitle</MudText>
            </MudPaper>
        </MudItem>
    }
</MudGrid>