@page "/compendium/{Kind}/{Id}"
@using AdventurersGuild.Editor.Compendium
@inject CompendiumService Compendium
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(isNew ? "Новый" : (Kind + " — " + Id))</PageTitle>

@if (Info is null)
{
    <MudAlert Severity="Severity.Error">Kind «@Kind» не зарегистрирован.</MudAlert>
    return;
}

@if (!isNew && entry is null)
{
    <MudAlert Severity="Severity.Warning" Class="mt-4">Сущность не найдена.</MudAlert>
    <MudButton OnClick="GoBack" Class="mt-2">← К списку</MudButton>
    return;
}

<MudText Typo="Typo.h4">
    @(isNew ? $"Новый {Info.SingularTitle}" : $"{Info.SingularTitle}: {Id}")
</MudText>

<div class="mt-4">
    <EntityJsonEditor Entity="workingJson" OnChanged="OnEntityChanged" />
</div>

<div class="d-flex gap-2 mt-2">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               OnClick="Save"
               Disabled="@(!dirty)">
        Сохранить
    </MudButton>
    <MudButton Variant="Variant.Outlined" OnClick="GoBack">Отмена</MudButton>
</div>

@code {
    [Parameter] public string Kind { get; set; } = "";
    [Parameter] public string Id { get; set; } = "";

    private CompendiumEntry? entry;
    private JsonObject workingJson = new();
    private bool isNew;
    private bool dirty;
    private string? lastKind;
    private string? lastId;

    private KindInfo? Info => Kinds.Get(Kind);

    protected override void OnParametersSet()
    {
        if (lastKind == Kind && lastId == Id) return;

        lastKind = Kind;
        lastId = Id;

        isNew = Id == "__new__";
        dirty = false;

        if (Info is null) return;

        if (isNew)
        {
            entry = null;
            workingJson = new JsonObject { [Info.IdField] = "" };
        }
        else
        {
            entry = Compendium.Index.Get(Kind, Id);
            workingJson = entry is null
                ? new JsonObject()
                : (JsonObject)entry.Json.DeepClone();
        }
    }

    private void OnEntityChanged()
    {
        dirty = true;
    }

    private void Save()
    {
        if (Info is null) { Snackbar.Add("Kind не найден", Severity.Error); return; }

        string idField = Info.IdField;
        string newId = workingJson[idField]?.GetValue<string>() ?? "";

        if (string.IsNullOrWhiteSpace(newId))
        {
            Snackbar.Add($"Поле «{idField}» не может быть пустым", Severity.Warning);
            return;
        }

        if (isNew && Compendium.Index.Exists(Kind, newId))
        {
            Snackbar.Add($"Запись с ID '{newId}' уже существует", Severity.Error);
            return;
        }

        try
        {
            if (isNew)
            {
                var fresh = new CompendiumEntry
                {
                    Kind = Kind,
                    Id = newId,
                    Json = workingJson,
                    DisplayName = ExtractDisplayName(workingJson, Info),
                };
                fresh.SetInitialSnapshot();
                Compendium.SaveNew(fresh);
                Snackbar.Add($"Создано: {newId}", Severity.Success);
            }
            else
            {
                if (entry is null) { Snackbar.Add("Внутренняя ошибка", Severity.Error); return; }

                entry.Json.Clear();
                foreach (var kv in workingJson.ToList())
                    entry.Json[kv.Key] = kv.Value?.DeepClone();

                entry.DisplayName = ExtractDisplayName(entry.Json, Info);
                Compendium.Save(entry);
                Snackbar.Add($"Сохранено: {newId}", Severity.Success);
            }

            Nav.NavigateTo($"/compendium/{Kind}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка сохранения: {ex.Message}", Severity.Error);
        }
    }

    private void GoBack() => Nav.NavigateTo($"/compendium/{Kind}");

    private static string ExtractDisplayName(JsonObject obj, KindInfo info)
    {
        var node = obj[info.DisplayField];
        if (node is JsonObject localized)
        {
            var ru = localized["ru"];
            if (ru is JsonValue rv) return rv.GetValue<string>() ?? obj[info.IdField]?.GetValue<string>() ?? "?";
            if (ru is JsonObject ro) return ro["nom"]?.GetValue<string>() ?? obj[info.IdField]?.GetValue<string>() ?? "?";
        }
        return obj[info.IdField]?.GetValue<string>() ?? "?";
    }
}