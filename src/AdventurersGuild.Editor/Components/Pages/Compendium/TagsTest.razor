@page "/compendium/tags-test"
@inject CompendiumService Compendium

<PageTitle>Tags (test)</PageTitle>

<MudText Typo="Typo.h4">Теги (@Count)</MudText>

<MudTable Items="@Entries" Dense="true" Hover="true" Class="mt-4">
    <HeaderContent>
        <MudTh>Id</MudTh>
        <MudTh>Имя (ru)</MudTh>
        <MudTh>Имя (en)</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Id</MudTd>
        <MudTd>@(context.Json["name"]?["ru"]?.GetValue<string>())</MudTd>
        <MudTd>@(context.Json["name"]?["en"]?.GetValue<string>())</MudTd>
    </RowTemplate>
</MudTable>

@code {
    private IReadOnlyList<CompendiumEntry> Entries =>
        Compendium.Index.AllOfKind("tag").ToList();

    private int Count => Entries.Count;
}