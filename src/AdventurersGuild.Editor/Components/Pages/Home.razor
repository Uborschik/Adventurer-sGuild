@page "/"
@inject DataLoader Loader
@inject CreatureRepository CreatureRepo
@inject LocationRepository LocationRepo

<PageTitle>Compendium Editor</PageTitle>

<MudText Typo="Typo.h3">Compendium</MudText>

<MudGrid Class="mt-4">
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.caption">Существа</MudText>
            <MudText Typo="Typo.h5">@Creatures.Count</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.caption">Локации</MudText>
            <MudText Typo="Typo.h5">@Locations.Count</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.caption">Blueprint'ы</MudText>
            <MudText Typo="Typo.h5">@Blueprints.Count</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.caption">Теги</MudText>
            <MudText Typo="Typo.h5">@Tags.Count</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudText Typo="Typo.h5" Class="mt-6">Существа</MudText>

<MudTable Items="@Creatures" Dense="true" Hover="true" Class="mt-2">
    <HeaderContent>
        <MudTh>Id</MudTh>
        <MudTh>Имя (ru)</MudTh>
        <MudTh>Имя (en)</MudTh>
        <MudTh>Ур.</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Id</MudTd>
        <MudTd>@context.Name?.Ru?.Nom</MudTd>
        <MudTd>@context.Name?.En</MudTd>
        <MudTd>@context.MinLvl–@context.MaxLvl</MudTd>
    </RowTemplate>
</MudTable>

@code {
    protected override void OnInitialized()
    {
        _ = CreatureRepo.All;
        _ = LocationRepo.All;
    }

    private IReadOnlyList<CreatureInfo> Creatures => CreatureRepo.All;

    private IReadOnlyList<LocationInfo> Locations => LocationRepo.All;

    private IReadOnlyList<Blueprint> Blueprints =>
        QuestDatabase.Blueprints?.Values.ToList() ?? new();

    private IReadOnlyList<TagInfo> Tags =>
        QuestDatabase.Tags?.Values.ToList() ?? new();
}