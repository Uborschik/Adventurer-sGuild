@inherits LayoutComponentBase

<MudThemeProvider @bind-IsDarkMode="_isDarkMode" Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Fixed="true" Class="app-drag-bar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@(() => drawerOpen = !drawerOpen)" />

        <div class="drag-region"
             @onmousedown="StartDrag"
             @ondblclick="ToggleMaximizeApp">
            <MudText Typo="Typo.h6">Adventurer's Guild — Editor</MudText>
        </div>

        <MudSpacer />

        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       OnClick="ToggleTheme"
                       title="Сменить тему" />

        <MudIconButton Icon="@Icons.Material.Filled.Remove"
                       Color="Color.Inherit"
                       OnClick="MinimizeApp"
                       title="Свернуть" />
        <MudIconButton Icon="@Icons.Material.Filled.CropSquare"
                       Color="Color.Inherit"
                       OnClick="ToggleMaximizeApp"
                       title="Развернуть" />
        <MudIconButton Icon="@Icons.Material.Filled.Close"
                       Color="Color.Inherit"
                       OnClick="CloseApp"
                       title="Закрыть" />
    </MudAppBar>

    <MudDrawer @bind-Open="drawerOpen"
               Elevation="1"
               ClipMode="DrawerClipMode.Always"
               Width="280px">
        <SchemaSidebar />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<style>
    .drag-region {
        display: flex;
        align-items: center;
        flex: 1 1 auto;
        height: 100%;
        cursor: default;
        user-select: none;
        -webkit-user-select: none;
    }
</style>

@code {
    [Inject] public IJSRuntime JS { get; set; } = default!;

    private bool drawerOpen = true;
    private bool _isDarkMode = false;
    private bool _themeLoaded = false;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight(),
        PaletteDark = new PaletteDark(),
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_themeLoaded)
        {
            _themeLoaded = true;
            try
            {
                var saved = await JS.InvokeAsync<string?>("themePrefs.get");
                _isDarkMode = saved == "dark";

                try
                {
                    await JS.InvokeVoidAsync("jsonEditor.setTheme", _isDarkMode ? "material-darker" : "default");
                }
                catch { }

                if (_isDarkMode) StateHasChanged();
            }
            catch { }
        }
    }

    private async Task ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
        try
        {
            await JS.InvokeVoidAsync("themePrefs.set", _isDarkMode ? "dark" : "light");
            await JS.InvokeVoidAsync("jsonEditor.setTheme", _isDarkMode ? "material-darker" : "default");
        }
        catch { }
    }

    private async Task CloseApp()
    {
        try { await JS.InvokeVoidAsync("appWindow.close"); }
        catch { }
    }

    private async Task MinimizeApp()
    {
        try { await JS.InvokeVoidAsync("appWindow.minimize"); }
        catch { }
    }

    private async Task ToggleMaximizeApp()
    {
        try { await JS.InvokeVoidAsync("appWindow.toggleMaximize"); }
        catch { }
    }

    private async Task StartDrag()
    {
        try { await JS.InvokeVoidAsync("appWindow.startDrag"); }
        catch { }
    }
}