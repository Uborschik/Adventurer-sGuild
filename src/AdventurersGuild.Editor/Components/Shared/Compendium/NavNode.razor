@namespace AdventurersGuild.Editor.Components.Shared.Compendium

@if (Node.Children.Count > 0)
{
    <MudNavGroup Title="@Node.Name"
                 Icon="@SectionIcon(Node.Name)"
                 Expanded="true">
        @foreach (var child in Node.Children.OrderBy(c => c.Order))
        {
            <NavNode Node="child" />
        }
    </MudNavGroup>
}
else if (Node.Kind is not null)
{
    <MudNavLink Href="@($"/compendium/{Node.Kind.Kind}")"
                Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Filled.Circle">
        @Node.Kind.PluralTitle
    </MudNavLink>
}

@code {
    [Parameter, EditorRequired] public NavNodeModel Node { get; set; } = default!;

    private static string SectionIcon(string section) => section switch
    {
        "Мир"     => Icons.Material.Filled.Public,
        "Расы"    => Icons.Material.Filled.People,
        "Квесты"  => Icons.Material.Filled.Map,
        "Прочее"  => Icons.Material.Filled.Folder,
        _         => Icons.Material.Filled.Folder,
    };
}