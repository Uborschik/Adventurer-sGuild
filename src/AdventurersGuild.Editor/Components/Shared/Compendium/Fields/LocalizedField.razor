@namespace AdventurersGuild.Editor.Components.Shared.Compendium.Fields

<MudGrid Spacing="2">
    <MudItem xs="12" md="6">
        <MudTextField T="string"
                      Value="@RuValue"
                      ValueChanged="@OnRuChanged"
                      Label="@(Field.Label + " (RU)")"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Required="@Field.Required" />
    </MudItem>
    <MudItem xs="12" md="6">
        <MudTextField T="string"
                      Value="@EnValue"
                      ValueChanged="@OnEnChanged"
                      Label="@(Field.Label + " (EN)")"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense" />
    </MudItem>
</MudGrid>

@code {
    [Parameter, EditorRequired] public FieldSchema Field { get; set; } = default!;
    [Parameter] public JsonNode? Node { get; set; }
    [Parameter] public EventCallback<JsonNode?> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    private string RuValue => (Node as JsonObject)?["ru"]?.GetValue<string>() ?? "";
    private string EnValue => (Node as JsonObject)?["en"]?.GetValue<string>() ?? "";

    private async Task OnRuChanged(string? v)
    {
        var obj = EnsureObject();
        obj["ru"] = v ?? "";
        await ValueChanged.InvokeAsync(obj);
    }

    private async Task OnEnChanged(string? v)
    {
        var obj = EnsureObject();
        obj["en"] = v ?? "";
        await ValueChanged.InvokeAsync(obj);
    }

    private JsonObject EnsureObject()
    {
        if (Node is JsonObject obj) return obj;

        var fresh = new JsonObject { ["ru"] = "", ["en"] = "" };
        Node = fresh;
        return fresh;
    }
}