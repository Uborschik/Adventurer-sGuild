@namespace AdventurersGuild.Editor.Components.Shared.Compendium.Fields

<MudText Typo="Typo.subtitle2" Class="mb-2">@Field.Label</MudText>

<MudText Typo="Typo.caption" Class="mb-1">Русский — падежи</MudText>
<MudGrid Spacing="2">
    <MudItem xs="12" sm="6" md="4">
        <MudTextField T="string" Value="@GetRu("nom")" ValueChanged="@(v => SetRu("nom", v))"
                      Label="Именительный" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudTextField T="string" Value="@GetRu("gen")" ValueChanged="@(v => SetRu("gen", v))"
                      Label="Родительный" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudTextField T="string" Value="@GetRu("dat")" ValueChanged="@(v => SetRu("dat", v))"
                      Label="Дательный" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudTextField T="string" Value="@GetRu("acc")" ValueChanged="@(v => SetRu("acc", v))"
                      Label="Винительный" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudTextField T="string" Value="@GetRu("ins")" ValueChanged="@(v => SetRu("ins", v))"
                      Label="Творительный" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudTextField T="string" Value="@GetRu("pre")" ValueChanged="@(v => SetRu("pre", v))"
                      Label="Предложный" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </MudItem>
</MudGrid>

<MudText Typo="Typo.caption" Class="mb-1 mt-2">English</MudText>
<MudTextField T="string" Value="@GetEn()" ValueChanged="@SetEn"
              Label="English" Variant="Variant.Outlined" Margin="Margin.Dense" />

@code {
    [Parameter, EditorRequired] public FieldSchema Field { get; set; } = default!;
    [Parameter] public JsonNode? Node { get; set; }
    [Parameter] public EventCallback<JsonNode?> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    private static readonly string[] Cases = { "nom", "gen", "dat", "acc", "ins", "pre" };

    private string GetRu(string caseName)
        => (Node as JsonObject)?["ru"]?[caseName]?.GetValue<string>() ?? "";

    private string GetEn()
        => (Node as JsonObject)?["en"]?.GetValue<string>() ?? "";

    private async Task SetRu(string caseName, string? value)
    {
        var obj = EnsureObject();
        var ru = EnsureRu(obj);
        ru[caseName] = value ?? "";
        await ValueChanged.InvokeAsync(obj);
    }

    private async Task SetEn(string? value)
    {
        var obj = EnsureObject();
        obj["en"] = value ?? "";
        await ValueChanged.InvokeAsync(obj);
    }

    private JsonObject EnsureObject()
    {
        if (Node is JsonObject obj) return obj;
        var fresh = new JsonObject { ["ru"] = EmptyRu(), ["en"] = "" };
        Node = fresh;
        return fresh;
    }

    private static JsonObject EnsureRu(JsonObject obj)
    {
        if (obj["ru"] is JsonObject ru) return ru;
        var fresh = EmptyRu();
        obj["ru"] = fresh;
        return fresh;
    }

    private static JsonObject EmptyRu()
    {
        var o = new JsonObject();
        foreach (var c in Cases) o[c] = "";
        return o;
    }
}