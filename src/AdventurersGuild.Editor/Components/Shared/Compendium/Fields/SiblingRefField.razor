@namespace AdventurersGuild.Editor.Components.Shared.Compendium.Fields

<MudSelect T="string"
           Value="@CurrentValue"
           ValueChanged="@OnValueChanged"
           Label="@Field.Label"
           HelperText="@Field.Hint"
           Variant="Variant.Outlined"
           Margin="Margin.Dense"
           Disabled="@ReadOnly">
    @foreach (var option in Options())
    {
        <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
    }
</MudSelect>

@code {
    [Parameter, EditorRequired] public FieldSchema Field { get; set; } = default!;
    [Parameter] public JsonNode? Node { get; set; }
    [Parameter] public JsonNode? ParentNode { get; set; }
    [Parameter] public EventCallback<JsonNode?> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    // Роль, к которой принадлежит текущий state. Пробрасывается из EntityDetail.
    [CascadingParameter(Name = "CompendiumRoot")] public JsonNode? RootNode { get; set; }

    private string CurrentValue => Node?.GetValue<string>() ?? "";

    private async Task OnValueChanged(string? v)
    {
        await ValueChanged.InvokeAsync(JsonValue.Create(v ?? ""));
    }

    private IEnumerable<string> Options()
    {
        var result = new List<string> { "end" };

        if (string.IsNullOrEmpty(Field.OptionsFromParentArray))
            return result;

        if (RootNode is not JsonObject root)
            return result;

        if (root[Field.OptionsFromParentArray] is not JsonArray arr)
            return result;

        foreach (var item in arr)
        {
            if (item is JsonObject obj)
            {
                var id = obj["id"]?.GetValue<string>();
                if (!string.IsNullOrEmpty(id))
                    result.Add(id);
            }
        }

        return result;
    }
}