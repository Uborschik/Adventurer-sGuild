@namespace AdventurersGuild.Editor.Components.Shared.Compendium.Fields
@inject SchemaRegistry Schemas

<MudText Typo="Typo.subtitle2" Class="mb-2">@Field.Label</MudText>

@if (items.Count == 0)
{
    <MudText Typo="Typo.caption" Class="mb-2">Пусто. Добавьте первую запись.</MudText>
}
else
{
    <MudExpansionPanels MultiExpansion="true" Elevation="0" Class="mb-2">
        @foreach (var item in items.ToList())
        {
            var local = item;
            var index = items.IndexOf(local);

            <MudExpansionPanel>
                <TitleContent>
                    <MudText Typo="Typo.body1">@ItemTitle(local, index)</MudText>
                </TitleContent>
                <ChildContent>
                    <EntityEditor Schema="NestedSchema"
                                  Entity="local"
                                  OnChanged="@(async () => await OnItemChanged())" />

                    <MudStack Row Class="mt-2">
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                       Size="Size.Small"
                                       Disabled="@(ReadOnly || index == 0)"
                                       OnClick="@(() => MoveUp(local))" />
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward"
                                       Size="Size.Small"
                                       Disabled="@(ReadOnly || index == items.Count - 1)"
                                       OnClick="@(() => MoveDown(local))" />
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                       Size="Size.Small"
                                       Disabled="@ReadOnly"
                                       OnClick="@(() => Duplicate(local))" />
                        <MudSpacer />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       Disabled="@ReadOnly"
                                       OnClick="@(() => Remove(local))" />
                    </MudStack>
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

<MudButton Variant="Variant.Outlined"
           StartIcon="@Icons.Material.Filled.Add"
           OnClick="Add"
           Disabled="@ReadOnly"
           Class="mt-2">
    Добавить
</MudButton>

@code {
    [Parameter, EditorRequired] public FieldSchema Field { get; set; } = default!;
    [Parameter] public JsonNode? Node { get; set; }
    [Parameter] public EventCallback<JsonNode?> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    private EntitySchema NestedSchema =>
        Schemas.GetInternal(Field.NestedSchemaName
            ?? throw new InvalidOperationException($"Field '{Field.Name}': NestedSchemaName не задан"));

    private List<JsonObject> items = new();

    protected override void OnParametersSet()
    {
        ReadFromNode();
    }

    private void ReadFromNode()
    {
        items = new();
        if (Node is not JsonArray arr) return;

        foreach (var item in arr)
        {
            if (item is JsonObject obj)
                items.Add(obj);
        }
    }

    private async Task Add()
    {
        var fresh = new JsonObject();

        // Префилл: заполняем все поля дефолтами из схемы
        foreach (var field in NestedSchema.Fields)
        {
            fresh[field.Name] = CreateDefaultForField(field);
        }

        items.Add(fresh);
        await Commit();
    }

    private static JsonNode CreateDefaultForField(FieldSchema field) => field.Type switch
    {
        CompendiumFieldType.Id => JsonValue.Create(""),
        CompendiumFieldType.Localized => new JsonObject { ["ru"] = "Новое", ["en"] = "New" },
        CompendiumFieldType.LocalizedCase => new JsonObject
        {
            ["ru"] = new JsonObject { ["nom"] = "Новое", ["gen"] = "", ["dat"] = "", ["acc"] = "", ["ins"] = "", ["pre"] = "" },
            ["en"] = "New",
        },
        CompendiumFieldType.Number => JsonValue.Create(0),
        CompendiumFieldType.Bool => JsonValue.Create(false),
        CompendiumFieldType.Enum => JsonValue.Create(""),
        CompendiumFieldType.Reference => JsonValue.Create(""),
        CompendiumFieldType.ReferenceList => new JsonArray(),
        CompendiumFieldType.Dictionary => new JsonObject(),
        CompendiumFieldType.Nested => new JsonObject(),
        CompendiumFieldType.ObjectList => new JsonArray(),
        CompendiumFieldType.SiblingRef => JsonValue.Create("end"),
        _ => JsonValue.Create(""),
    };

    private async Task Remove(JsonObject item)
    {
        items.Remove(item);
        await Commit();
    }

    private async Task Duplicate(JsonObject item)
    {
        int idx = items.IndexOf(item);
        if (idx < 0) return;

        var clone = (JsonObject)item.DeepClone();
        items.Insert(idx + 1, clone);
        await Commit();
    }

    private async Task MoveUp(JsonObject item)
    {
        int idx = items.IndexOf(item);
        if (idx <= 0) return;

        items.RemoveAt(idx);
        items.Insert(idx - 1, item);
        await Commit();
    }

    private async Task MoveDown(JsonObject item)
    {
        int idx = items.IndexOf(item);
        if (idx < 0 || idx >= items.Count - 1) return;

        items.RemoveAt(idx);
        items.Insert(idx + 1, item);
        await Commit();
    }

    private async Task OnItemChanged()
    {
        await Commit();
    }

    private async Task Commit()
    {
        var arr = new JsonArray();
        foreach (var it in items)
            arr.Add(it.DeepClone());

        await ValueChanged.InvokeAsync(arr);
        StateHasChanged();
    }

    private string ItemTitle(JsonObject item, int index)
    {
        var displayField = NestedSchema.DisplayField;
        var idField = NestedSchema.IdField;

        var node = item[displayField];
        if (node is JsonObject loc)
        {
            var ru = loc["ru"];
            if (ru is JsonValue rv) return rv.GetValue<string>() ?? $"#{index + 1}";
            if (ru is JsonObject ro) return ro["nom"]?.GetValue<string>() ?? $"#{index + 1}";
        }

        var idNode = item[idField];
        if (idNode is JsonValue iv) return iv.GetValue<string>() ?? $"#{index + 1}";

        return $"#{index + 1}";
    }
}