@namespace AdventurersGuild.Editor.Components.Shared.Compendium.Fields

<MudNumericField T="double?"
                 Value="@CurrentValue"
                 ValueChanged="@OnValueChanged"
                 Label="@Field.Label"
                 HelperText="@Field.Hint"
                 Variant="Variant.Outlined"
                 Margin="Margin.Dense"
                 Min="@Field.Min"
                 Max="@Field.Max"
                 Step="@(Field.Step ?? 0.1)"
                 Required="@Field.Required"
                 ReadOnly="@ReadOnly" />

@code {
    [Parameter, EditorRequired] public FieldSchema Field { get; set; } = default!;
    [Parameter] public JsonNode? Node { get; set; }
    [Parameter] public EventCallback<JsonNode?> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    private double? CurrentValue
    {
        get
        {
            if (Node is JsonValue v && v.TryGetValue<double>(out var d))
                return d;
            return null;
        }
    }

    private async Task OnValueChanged(double? v)
    {
        if (v is null)
        {
            await ValueChanged.InvokeAsync(null);
            return;
        }
        await ValueChanged.InvokeAsync(JsonValue.Create(v.Value));
    }
}