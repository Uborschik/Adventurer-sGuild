@namespace AdventurersGuild.Editor.Components.Shared.Compendium.Fields

<MudTextField T="string"
              Value="@CurrentValue"
              ValueChanged="@OnValueChanged"
              Label="@Field.Label"
              HelperText="@Field.Hint"
              Variant="Variant.Outlined"
              Margin="Margin.Dense"
              Required="@Field.Required"
              Disabled="@ReadOnly"
              Error="@(!string.IsNullOrEmpty(error))"
              ErrorText="@error" />

@code {
    [Parameter, EditorRequired] public FieldSchema Field { get; set; } = default!;
    [Parameter] public JsonNode? Node { get; set; }
    [Parameter] public EventCallback<JsonNode?> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    private string? error;

    private string CurrentValue => Node?.GetValue<string>() ?? "";

    private async Task OnValueChanged(string? v)
    {
        v ??= "";
        error = ValidateId(v);
        await ValueChanged.InvokeAsync(JsonValue.Create(v));
    }

    private string? ValidateId(string id)
    {
        if (string.IsNullOrWhiteSpace(id))
            return Field.Required ? "ID обязателен" : null;

        if (id.Length > 64)
            return "ID слишком длинный (макс. 64)";

        if (!System.Text.RegularExpressions.Regex.IsMatch(id, "^[a-z][a-z0-9_]*$"))
            return "Только a-z, 0-9, _, первая — буква";

        return null;
    }
}