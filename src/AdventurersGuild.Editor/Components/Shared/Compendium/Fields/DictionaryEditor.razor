@namespace AdventurersGuild.Editor.Components.Shared.Compendium.Fields
@inject CompendiumService Compendium

<MudText Typo="Typo.subtitle2" Class="mb-2">@Field.Label</MudText>

@if (entries.Count == 0)
{
    <MudText Typo="Typo.caption" Class="mb-2">Пусто. Добавьте первую запись.</MudText>
}
else
{
    @foreach (var entry in entries.ToList())
    {
        var local = entry;

        <MudGrid Spacing="2" Class="mb-1">
            <MudItem xs="12" sm="6" md="5">
                @if (string.IsNullOrEmpty(Field.TargetKind))
                {
                    <MudTextField T="string"
                                  Value="@local.Key"
                                  ValueChanged="@(v => SetKey(local, v))"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Label="Ключ"
                                  Disabled="@ReadOnly" />
                }
                else
                {
                    <MudSelect T="string"
                               Value="@local.Key"
                               ValueChanged="@(v => SetKey(local, v))"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Label="Ключ"
                               Disabled="@ReadOnly">
                        @foreach (var key in FreeKeys(local))
                        {
                            <MudSelectItem T="string" Value="@key">@DisplayKey(key)</MudSelectItem>
                        }
                    </MudSelect>
                }
            </MudItem>
            <MudItem xs="8" sm="4" md="5">
                <MudNumericField T="double?"
                                 Value="@local.Value"
                                 ValueChanged="@(v => SetValue(local, v))"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Step="@(Field.Step ?? 0.05)"
                                 Label="Значение"
                                 Disabled="@ReadOnly" />
            </MudItem>
            <MudItem xs="4" sm="2" md="2">
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               OnClick="@(() => Remove(local))"
                               Disabled="@ReadOnly" />
            </MudItem>
        </MudGrid>
    }
}

<MudButton Variant="Variant.Outlined"
           StartIcon="@Icons.Material.Filled.Add"
           OnClick="Add"
           Disabled="@ReadOnly"
           Class="mt-2">
    Добавить
</MudButton>

@code {
    [Parameter, EditorRequired] public FieldSchema Field { get; set; } = default!;
    [Parameter] public JsonNode? Node { get; set; }
    [Parameter] public EventCallback<JsonNode?> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    public sealed class Entry
    {
        public string Key { get; set; } = "";
        public double? Value { get; set; }
    }

    private List<Entry> entries = new();

    protected override void OnParametersSet()
    {
        ReadFromNode();
    }

    private void ReadFromNode()
    {
        // Сохраняем пустые строки, добавленные пользователем
        var emptyRows = entries
            .Where(e => string.IsNullOrEmpty(e.Key))
            .ToList();

        entries = new();

        if (Node is JsonObject obj)
        {
            foreach (var kv in obj)
            {
                double? val = null;
                if (kv.Value is JsonValue v && v.TryGetValue<double>(out var d))
                    val = d;

                entries.Add(new Entry { Key = kv.Key, Value = val });
            }
        }

        entries.AddRange(emptyRows);
    }

    private async Task Add()
    {
        entries.Add(new Entry { Key = "", Value = 1.0 });
        StateHasChanged();
        await Task.CompletedTask;
    }

    private async Task Remove(Entry entry)
    {
        entries.Remove(entry);
        await Commit();
    }

    private async Task SetKey(Entry entry, string? newKey)
    {
        newKey ??= "";

        if (string.IsNullOrEmpty(newKey)) return;
        if (entry.Key == newKey) return;

        // Не занят другой строкой
        if (entries.Any(e => e != entry && e.Key == newKey)) return;

        entry.Key = newKey;
        await Commit();
    }

    private async Task SetValue(Entry entry, double? value)
    {
        entry.Value = value;
        await Commit();
    }

    private async Task Commit()
    {
        var obj = new JsonObject();

        foreach (var e in entries)
        {
            if (string.IsNullOrEmpty(e.Key)) continue;

            obj[e.Key] = e.Value.HasValue
                ? JsonValue.Create(e.Value.Value)
                : null;
        }

        await ValueChanged.InvokeAsync(obj);
        StateHasChanged();
    }

    /// <summary>
    /// Доступные ключи: все ID из TargetKind минус занятые другими + свой ключ.
    /// </summary>
    private IEnumerable<string> FreeKeys(Entry current)
    {
        if (string.IsNullOrEmpty(Field.TargetKind))
            return Enumerable.Empty<string>();

        var usedByOthers = entries
            .Where(e => e != current && !string.IsNullOrEmpty(e.Key))
            .Select(e => e.Key)
            .ToHashSet();

        return Compendium.Index.AllOfKind(Field.TargetKind)
            .Select(e => e.Id)
            .Where(id => !usedByOthers.Contains(id))
            .OrderBy(id => id);
    }

    private string DisplayKey(string id)
    {
        if (string.IsNullOrEmpty(id)) return "(выберите)";
        if (string.IsNullOrEmpty(Field.TargetKind)) return id;

        var entry = Compendium.Index.Get(Field.TargetKind, id);
        return entry != null ? $"{entry.DisplayName} ({id})" : id;
    }
}