@namespace AdventurersGuild.Editor.Components.Shared.Compendium

@if (Field is null)
{
    return;
}

@switch (Field.Type)
{
    case CompendiumFieldType.Id:
        <IdField Field="Field" Node="Node" ValueChanged="ValueChanged" ReadOnly="ReadOnly" />
        break;

    case CompendiumFieldType.Localized:
        <LocalizedField Field="Field" Node="Node" ValueChanged="ValueChanged" ReadOnly="ReadOnly" />
        break;

    case CompendiumFieldType.LocalizedCase:
        <LocalizedCaseField Field="Field" Node="Node" ValueChanged="ValueChanged" ReadOnly="ReadOnly" />
        break;

    case CompendiumFieldType.Number:
        <NumberField Field="Field" Node="Node" ValueChanged="ValueChanged" ReadOnly="ReadOnly" />
        break;

    case CompendiumFieldType.Bool:
        <BoolField Field="Field" Node="Node" ValueChanged="ValueChanged" ReadOnly="ReadOnly" />
        break;

    case CompendiumFieldType.Enum:
        <EnumField Field="Field" Node="Node" ValueChanged="ValueChanged" ReadOnly="ReadOnly" />
        break;

    case CompendiumFieldType.Reference:
        <ReferenceField Field="Field" Node="Node" ValueChanged="ValueChanged" ReadOnly="ReadOnly" />
        break;

    case CompendiumFieldType.ReferenceList:
        <ReferenceListField Field="Field" Node="Node" ValueChanged="ValueChanged" ReadOnly="ReadOnly" />
        break;

    case CompendiumFieldType.Dictionary:
        <DictionaryEditor Field="Field" Node="Node" ValueChanged="ValueChanged" ReadOnly="ReadOnly" />
        break;

    case CompendiumFieldType.Nested:
        <NestedEditor Field="Field" Node="Node" ValueChanged="ValueChanged" ReadOnly="ReadOnly" />
        break;

    case CompendiumFieldType.ObjectList:
        <ObjectListEditor Field="Field" Node="Node" ValueChanged="ValueChanged" ReadOnly="ReadOnly" />
        break;

    case CompendiumFieldType.SiblingRef:
        <SiblingRefField Field="Field" Node="Node" ParentNode="ParentNode" ValueChanged="ValueChanged" ReadOnly="ReadOnly" />
        break;

    default:
        <MudAlert Severity="Severity.Warning" Dense="true">
            Поле «@Field.Name»: тип @Field.Type ещё не поддержан.
        </MudAlert>
        break;
}

@code {
    [Parameter, EditorRequired] public FieldSchema Field { get; set; } = default!;
    [Parameter] public JsonNode? ParentNode { get; set; }
    [Parameter] public JsonNode? Node { get; set; }
    [Parameter] public EventCallback<JsonNode?> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
}