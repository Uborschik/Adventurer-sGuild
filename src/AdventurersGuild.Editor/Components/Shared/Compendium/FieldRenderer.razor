@namespace AdventurersGuild.Editor.Components.Shared.Compendium

@if (Field is null)
{
    return;
}

@switch (Field.Type)
{
    case CompendiumFieldType.Id:
        <IdField Field="Field" Node="Node" ValueChanged="ValueChanged" ReadOnly="ReadOnly" />
        break;

    case CompendiumFieldType.Localized:
        <LocalizedField Field="Field" Node="Node" ValueChanged="ValueChanged" ReadOnly="ReadOnly" />
        break;

    default:
        <MudAlert Severity="Severity.Warning" Dense="true">
            Поле «@Field.Name»: тип @Field.Type ещё не поддержан.
        </MudAlert>
        break;
}

@code {
    [Parameter, EditorRequired] public FieldSchema Field { get; set; } = default!;
    [Parameter] public JsonNode? Node { get; set; }
    [Parameter] public EventCallback<JsonNode?> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
}