@namespace AdventurersGuild.Editor.Components.Shared.Compendium
@inject AdventurersGuild.Editor.Services.Compendium.CompendiumService Compendium
@inject IJSRuntime JS

<div class="json-editor-wrapper">
    <div @ref="_container" class="json-editor-container"></div>

    <MudStack Row Class="mt-2" AlignItems="AlignItems.Center">
        <MudButton Variant="Variant.Outlined"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.FormatAlignLeft"
                   OnClick="FormatAsync"
                   Disabled="@ReadOnly">
            Форматировать
        </MudButton>
        <MudSpacer />
        @if (isValid)
        {
            <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.Check">
                JSON валиден
            </MudChip>
        }
        else
        {
            <MudChip T="string" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.Error">
                @errorMessage
            </MudChip>
        }
    </MudStack>
</div>

<style>
    .json-editor-wrapper {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 0;
    }

    .json-editor-container {
        flex: 1;
        min-height: 0;
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 4px;
        overflow: hidden;
    }

    .json-editor-container .CodeMirror {
        height: 100%;
        font-family: 'Consolas', 'Courier New', monospace;
        font-size: 13px;
    }
</style>

@code {
    [Parameter] public JsonObject Entity { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    private ElementReference _container;
    private string? _editorId;
    private DotNetObjectReference<EntityJsonEditor>? _selfRef;
    private bool isValid = true;
    private string errorMessage = "";
    private string lastSerialized = "";
    private bool _firstRenderDone;

    private static readonly System.Text.Json.JsonSerializerOptions PrettyOpts = new()
    {
        WriteIndented = true,
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_firstRenderDone)
        {
            _firstRenderDone = true;
            _selfRef = DotNetObjectReference.Create(this);

            string json = Entity.ToJsonString(PrettyOpts);
            lastSerialized = json;

            var stats = Compendium.Index.AllOfKind("stat").Select(e => e.Id).ToList();
            var skills = Compendium.Index.AllOfKind("skill").Select(e => e.Id).ToList();

            var hints = new Dictionary<string, List<string>>
            {
                // Существа и Классы
                ["speciesId"] = Compendium.Index.AllOfKind("humanoid-species").Select(e => e.Id)
                    .Concat(Compendium.Index.AllOfKind("beast-species").Select(e => e.Id)).ToList(),
                ["classId"] = Compendium.Index.AllOfKind("humanoid-class").Select(e => e.Id)
                    .Concat(Compendium.Index.AllOfKind("beast-class").Select(e => e.Id)).ToList(),
                
                // Роли и Квесты
                ["roleId"] = Compendium.Index.AllOfKind("role").Select(e => e.Id).ToList(),
                ["phaseId"] = Compendium.Index.AllOfKind("phase").Select(e => e.Id).ToList(),
                
                // Инструкции
                ["instructionId"] = Compendium.Index.AllOfKind("instruction").Select(e => e.Id).ToList(),
                ["id"] = Compendium.Index.AllOfKind("instruction").Select(e => e.Id).ToList(), // Для success/fail
                
                // Статы и навыки (в ролях, классах, species)
                ["actorStat"] = stats,
                ["targetSkill"] = skills,
                ["primaryStat"] = stats,
                ["secondaryStat"] = stats,
                
                // Навыки (в классах)
                ["primarySkill"] = skills,
                ["secondarySkill"] = skills,
                ["skillId"] = skills,
            };

            await JS.InvokeVoidAsync("jsonEditor.setHints", hints);

            _editorId = await JS.InvokeAsync<string>(
                "jsonEditor.create", _container, _selfRef, json);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_editorId is null) return;

        string current = Entity.ToJsonString(PrettyOpts);
        if (current == lastSerialized) return;

        lastSerialized = current;
        await JS.InvokeVoidAsync("jsonEditor.setText", _editorId, current);
    }

    [JSInvokable]
    public async Task OnTextChanged(string text)
    {
        try
        {
            var parsed = JsonNode.Parse(text);
            if (parsed is not JsonObject parsedObj)
            {
                isValid = false;
                errorMessage = "корень должен быть объектом";
                StateHasChanged();
                return;
            }

            Entity.Clear();
            foreach (var kv in parsedObj.ToList())
                Entity[kv.Key] = kv.Value?.DeepClone();

            lastSerialized = Entity.ToJsonString(PrettyOpts);
            isValid = true;
            errorMessage = "";

            await OnChanged.InvokeAsync();
            StateHasChanged();
        }
        catch (System.Text.Json.JsonException ex)
        {
            isValid = false;
            errorMessage = $"строка {ex.LineNumber}, колонка {ex.BytePositionInLine}";
            StateHasChanged();
        }
    }

    private async Task FormatAsync()
    {
        if (_editorId is null) return;

        string formatted = Entity.ToJsonString(PrettyOpts);
        await JS.InvokeVoidAsync("jsonEditor.setText", _editorId, formatted);
        lastSerialized = formatted;
    }

    public async ValueTask DisposeAsync()
    {
        if (_editorId is not null)
        {
            try { await JS.InvokeVoidAsync("jsonEditor.destroy", _editorId); } catch { }
        }
        _selfRef?.Dispose();
    }
}