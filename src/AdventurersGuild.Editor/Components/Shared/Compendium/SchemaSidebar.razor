@namespace AdventurersGuild.Editor.Components.Shared.Compendium
@inject SchemaRegistry Schemas

<MudNavMenu Bordered="true" Rounded="true" Class="pa-2">

    <MudNavLink Href="/compendium"
                Match="NavLinkMatch.All"
                Icon="@Icons.Material.Filled.Home">
        Обзор
    </MudNavLink>

    @foreach (var node in Root.Children.OrderBy(n => n.Order))
    {
        <NavNode Node="node" />
    }

    <MudNavGroup Title="Инструменты"
                 Icon="@Icons.Material.Filled.Build"
                 Expanded="false">
        <MudNavLink Href="/tools/xp" Icon="@Icons.Material.Filled.TrendingUp">
            XP-кривые
        </MudNavLink>
        <MudNavLink Href="/tools/stats" Icon="@Icons.Material.Filled.BarChart">
            Статы по уровням
        </MudNavLink>
        <MudNavLink Href="/tools/validation" Icon="@Icons.Material.Filled.Rule">
            Валидация
        </MudNavLink>
    </MudNavGroup>

</MudNavMenu>

@code {
    private NavNodeModel Root = new();

    protected override void OnInitialized()
    {
        Root = BuildTree();
    }

    private static readonly Dictionary<string, int> NodeOrders = new()
    {
        ["Мир"]       = 10,
        ["Квесты"]    = 20,
        ["Прочее"]    = 30,

        ["Статы"]     = 1,
        ["Фазы"]      = 2,
        ["Локации"]   = 3,
        ["Бестиарий"] = 5,

        ["Виды"]      = 1,

        ["Гуманоиды"] = 1,
        ["Звери"]     = 2,

        ["Расы"]      = 1,
        ["Классы"]    = 2,
        ["Роли"]      = 3,
    };

    private int GetOrder(string nodeName, int fallback) => NodeOrders.TryGetValue(nodeName, out var o) ? o : fallback;

    private NavNodeModel BuildTree()
    {
        var root = new NavNodeModel { Name = "", Order = 0 };

        foreach (var schema in Schemas.All)
        {
            var section = string.IsNullOrEmpty(schema.Section) ? "Прочее" : schema.Section;
            var segments = section.Split('/', StringSplitOptions.RemoveEmptyEntries);

            var current = root;
            foreach (var seg in segments)
            {
                var existing = current.Children.FirstOrDefault(c => c.Name == seg);
                if (existing == null)
                {
                    existing = new NavNodeModel
                    {
                        Name = seg,
                        Order = GetOrder(seg, schema.Order),
                    };
                    current.Children.Add(existing);
                }
                current = existing;
            }

            if (current.Schema == null)
                current.Schema = schema;
        }

        return root;
    }
}