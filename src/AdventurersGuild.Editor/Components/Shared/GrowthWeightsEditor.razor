<MudText Typo="Typo.subtitle2">Веса роста</MudText>

<MudGrid Spacing="2" Class="mt-1">
    @foreach (var statId in StatIds.All)
    {
        <MudItem xs="12" sm="6" md="4">
            <MudNumericField T="double"
                             Value="@Get(statId)"
                             ValueChanged="@(v => Set(statId, v))"
                             Label="@UnitDatabase.StatName(statId)"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Step="0.05" />
        </MudItem>
    }
</MudGrid>

@code {
    [Parameter, EditorRequired] public Dictionary<string, double> Value { get; set; } = new();

    protected override void OnInitialized() => EnsureShape();

    private double Get(string id) => Value.TryGetValue(id, out var v) ? v : 0;

    private void Set(string id, double v)
    {
        EnsureShape();
        Value[id] = v;
    }

    private void EnsureShape()
    {
        Value ??= new();
        foreach (var statId in StatIds.All)
            if (!Value.ContainsKey(statId))
                Value[statId] = 0;
    }
}