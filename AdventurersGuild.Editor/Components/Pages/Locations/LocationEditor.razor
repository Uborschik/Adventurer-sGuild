@page "/locations/{Id}"
@inject LocationRepository Repo
@inject NavigationManager Nav

<PageTitle>Локация — @Id</PageTitle>

<MudText Typo="Typo.h4">@(isNew ? "Новая локация" : $"Локация: {Id}")</MudText>

@if (draft == null)
{
    <MudAlert Severity="Severity.Warning" Class="mt-4">Локация не найдена.</MudAlert>
    <MudButton OnClick="@GoBack" Class="mt-2">← К списку</MudButton>
}
else
{
    <MudPaper Class="pa-4 mt-4">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudTextField T="string"
                              @bind-Value="draft.Id"
                              Label="Id"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudNumericField T="double"
                                 @bind-Value="draft.DifficultyModifier"
                                 Label="Сложность"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Step="0.05" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudNumericField T="int"
                                 @bind-Value="draft.TravelDaysModifier"
                                 Label="Дорога, дней"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense" />
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-4" />

        <LocalizedNounEditor Value="draft.Name" />
    </MudPaper>

    @if (!string.IsNullOrEmpty(error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@error</MudAlert>
    }

    <div class="d-flex gap-2 mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Сохранить</MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="GoBack">Отмена</MudButton>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private LocationInfo draft;
    private string error;
    private bool isNew;

    protected override void OnParametersSet()
    {
        error = null;
        isNew = Id == "__new__";

        if (isNew)
        {
            draft = Repo.NewDraft();
        }
        else
        {
            var src = Repo.Get(Id);
            draft = src == null ? null : LocationRepository.Clone(src);
        }
    }

    private void Save()
    {
        error = Repo.Save(draft, isNew);

        if (error == null)
        {
            Nav.NavigateTo("/locations");
        }
    }

    private void GoBack()
    {
        Nav.NavigateTo("/locations");
    }
}