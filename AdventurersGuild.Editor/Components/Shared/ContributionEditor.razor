<MudCard Outlined="true" Class="mb-3">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.subtitle1">
                Contribution #@(Index + 1)@(string.IsNullOrEmpty(Value.PhaseId) ? "" : $" — {Value.PhaseId}")
            </MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           Color="Color.Error"
                           Size="Size.Small"
                           OnClick="OnRemove" />
        </CardHeaderActions>
    </MudCardHeader>

    <MudCardContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudSelect T="string"
                           MultiSelection="true"
                           SelectedValues="@TagsValues"
                           SelectedValuesChanged="@OnTagsChanged"
                           Label="Теги"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense">
                    @foreach (var tag in AllTags)
                    {
                        <MudSelectItem T="string" Value="@tag.Id">
                            @tag.Id — @tag.Name.Get("ru")
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect T="string"
                           @bind-Value="Value.PhaseId"
                           Label="Фаза"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense">
                    @foreach (var phase in AllPhases)
                    {
                        <MudSelectItem T="string" Value="@phase.Id">
                            @phase.Id — @phase.Name.Get("ru")
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="4" sm="2">
                <MudNumericField T="int"
                                 @bind-Value="Value.Duration"
                                 Label="Длит., мин"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="4" sm="2">
                <MudNumericField T="int"
                                 @bind-Value="Value.Exp"
                                 Label="Опыт"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="4" sm="2">
                <MudNumericField T="int"
                                 @bind-Value="Value.Weight"
                                 Label="Вес"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense" />
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired] public CreatureContribution Value { get; set; } = new();
    [Parameter] public EventCallback OnRemove { get; set; }
    [Parameter] public int Index { get; set; }

    private IEnumerable<string> TagsValues =>
        Value.Tags ?? Enumerable.Empty<string>();

    private IEnumerable<TagInfo> AllTags =>
        QuestDatabase.Tags?.Values ?? Enumerable.Empty<TagInfo>();

    private IEnumerable<QuestPhaseTemplate> AllPhases =>
        QuestDatabase.Phases?.Values ?? Enumerable.Empty<QuestPhaseTemplate>();

    private void OnTagsChanged(IEnumerable<string> v)
    {
        Value.Tags = v.ToList();
    }
}