<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>AdventurersGuild</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Core\Databases\Generated\**" />
    <EmbeddedResource Remove="Core\Databases\Generated\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="AdventurersGuild.Domain\**\*.cs" />
    <Compile Remove="AdventurersGuild.Data\**\*.cs" />
    <Compile Remove="AdventurersGuild.Editor\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="AdventurersGuild.Domain\AdventurersGuild.Domain.csproj" />
    <ProjectReference Include="AdventurersGuild.Data\AdventurersGuild.Data.csproj" />
  </ItemGroup>
</Project>